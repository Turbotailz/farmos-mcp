# Copy to a file outside the repo, for example ~/.config/farmos-mcp/dunslaw.env
# Then point the MCP host at it with FARMOS_ENV_FILE.

FARMOS_URL=https://farm.example.com
FARMOS_CLIENT_ID=farmos-mcp
FARMOS_CLIENT_SECRET=
FARMOS_SCOPE=farm_worker

# Password grant instead of client credentials. Needs the simple_oauth_password_grant module.
# FARMOS_USERNAME=
# FARMOS_PASSWORD=

# Writes stay off until you mean it. There is no delete tool.
FARMOS_ALLOW_WRITES=false
FARMOS_ALLOW_DELETE=false

# HTTP transport (farmos-mcp --http). Required when the bind address is not loopback.
FARMOS_MCP_HOST=127.0.0.1
FARMOS_MCP_PORT=8787
FARMOS_MCP_HTTP_TOKEN=
# Public origin ChatGPT and Gemini will use, once the tunnel exists.
# FARMOS_MCP_PUBLIC_URL=https://farmos-mcp.example.com
# FARMOS_MCP_STATE_DIR=/var/lib/farmos-mcp
# FARMOS_MCP_OAUTH_REDIRECTS=
# FARMOS_MCP_ALLOWED_ORIGINS=
